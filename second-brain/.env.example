# Identity B credentials. Copy to .env and fill in.
# NEVER commit .env. NEVER put Identity A credentials in this file.
#
#   cp .env.example .env

# --- Telegram (primary interface) -------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. Paste the token below.
# 3. Send your new bot any message, then run telegram_get_messages to find
#    your chat id and paste it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Push notifications (ntfy) ----------------------------------------------
# Install the ntfy app, subscribe to a topic, put the topic name below.
# Use a long random topic name — on the public server, the topic IS the
# password. Anyone who guesses it can read your alerts.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- SMS / voice (Twilio) ---------------------------------------------------
# From https://console.twilio.com. Optional — leave blank to disable.
# Costs real money per message and per call minute.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mailbox (Identity B only) ----------------------------------------------
# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
# Any IMAP provider works — adjust the hosts.
MAILBOX_IMAP_HOST=imap.gmail.com
MAILBOX_SMTP_HOST=smtp.gmail.com
MAILBOX_ADDRESS=
MAILBOX_APP_PASSWORD=

# --- Notion (workspace B) ---------------------------------------------------
# Create an INTERNAL integration at https://www.notion.so/profile/integrations
# Copy the secret (starts with ntn_). Then open each page or database you want
# reachable and connect it to the integration — an internal token only sees
# pages explicitly shared with it.
NOTION_B_TOKEN=

# --- WordPress (site B) -----------------------------------------------------
# Not wired into .mcp.json yet — see README, "Adding WordPress B".
WORDPRESS_B_URL=
WORDPRESS_B_USER=
WORDPRESS_B_APP_PASSWORD=
