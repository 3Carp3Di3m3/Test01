{
  "_comment": "Parked servers. The code in servers/ is written and compile-checked; these entries are held back only until their credentials exist in .env. To activate one, copy its block into the mcpServers object in .mcp.json and restart Claude Code.",
  "mcpServers": {
    "mailbox_b": {
      "command": "python3",
      "args": ["${CLAUDE_PROJECT_DIR}/servers/mailbox_mcp.py"],
      "env": {
        "MAILBOX_IMAP_HOST": "${MAILBOX_IMAP_HOST}",
        "MAILBOX_SMTP_HOST": "${MAILBOX_SMTP_HOST}",
        "MAILBOX_ADDRESS": "${MAILBOX_ADDRESS}",
        "MAILBOX_APP_PASSWORD": "${MAILBOX_APP_PASSWORD}"
      }
    },
    "twilio": {
      "command": "python3",
      "args": ["${CLAUDE_PROJECT_DIR}/servers/twilio_mcp.py"],
      "env": {
        "TWILIO_ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
        "TWILIO_AUTH_TOKEN": "${TWILIO_AUTH_TOKEN}",
        "TWILIO_FROM_NUMBER": "${TWILIO_FROM_NUMBER}"
      }
    },
    "notion_b": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_B_TOKEN}"
      }
    }
  }
}
